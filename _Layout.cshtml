<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - NextGen Store</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --accent-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            --accent-cyan: #06b6d4;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #334155;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Navbar Styling */
        .navbar-custom {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
        }

        .brand-logo {
            font-weight: 800;
            background: linear-gradient(135deg, #38bdf8 0%, #a855f7 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 1.4rem;
        }

        /* Glass Cards */
        .card-custom {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .card-custom:hover {
                transform: translateY(-6px);
                border-color: #6366f1;
                box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
            }

        /* Form Controls */
        .form-control-dark, .form-select-dark {
            background-color: #0f172a;
            border: 1px solid var(--border-color);
            color: var(--text-main);
            border-radius: 10px;
        }

            .form-control-dark:focus, .form-select-dark:focus {
                background-color: #0f172a;
                color: var(--text-main);
                border-color: #a855f7;
                box-shadow: 0 0 0 0.25rem rgba(168, 85, 247, 0.25);
            }

        /* Buttons */
        .btn-gradient {
            background: var(--accent-gradient);
            border: none;
            color: #ffffff;
            font-weight: 600;
            border-radius: 10px;
            transition: opacity 0.2s;
        }

            .btn-gradient:hover {
                opacity: 0.9;
                color: #ffffff;
            }

        .btn-outline-cyan {
            border: 1px solid var(--accent-cyan);
            color: var(--accent-cyan);
            border-radius: 10px;
            font-weight: 600;
        }

            .btn-outline-cyan:hover {
                background-color: var(--accent-cyan);
                color: #0f172a;
            }

        .price-tag {
            font-size: 1.35rem;
            font-weight: 800;
            color: #38bdf8;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
        <div class="container">
            <a class="navbar-brand brand-logo" href="@Url.Action("Index", "Catalog")">
                <i class="fa-solid fa-bolt me-2 text-warning"></i>Store Catalog
            </a>
            <span class="badge bg-dark border border-secondary text-light px-3 py-2 rounded-pill">
                ASP.NET MVC 5
            </span>
        </div>
    </nav>

    <div class="container pb-5">
        @RenderBody()
    </div>

    <footer class="mt-auto py-4 border-top border-secondary text-center" style="border-color: var(--border-color) !important;">
        <div class="container">
            <p class="mb-0 text-muted small">&copy; @DateTime.Now.Year ProductCatalogApp. Crafted with Modern UI.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>