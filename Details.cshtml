@model ProductCatalogApp.Models.Product

@{
    ViewBag.Title = Model.Name + " - Details";
}

<div class="pt-4 pb-3">
    <a href="@Url.Action("Index", "Catalog")" class="btn btn-outline-secondary text-light mb-4 px-3 py-2 border-secondary">
        <i class="fa-solid fa-arrow-left me-2"></i>Back to Catalog
    </a>
</div>

<!-- Premium Dark Product Card -->
<div class="card card-custom p-4 shadow-lg mb-5">
    <div class="row g-4 align-items-center">
        <!-- Left Column: Product Image -->
        <div class="col-md-5">
            <div class="rounded-4 overflow-hidden border border-secondary p-2 bg-dark text-center" style="min-height: 320px;">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded-3 w-100" style="max-height: 350px; object-fit: cover;" />
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 py-5">
                        <i class="fa-solid fa-image fa-4x text-secondary opacity-50 mb-2"></i>
                        <span class="text-secondary small">No Image Available</span>
                    </div>
                }
            </div>
        </div>

        <!-- Right Column: Product Info -->
        <div class="col-md-7 ps-md-4">
            <div class="mb-3">
                <span class="badge rounded-pill bg-purple-subtle text-warning border border-warning px-3 py-2">
                    @Model.Category
                </span>
            </div>

            <h2 class="fw-bold text-white mb-2 display-6">@Model.Name</h2>

            <!-- Indian Currency Display (₹) -->
            <div class="my-3">
                <span class="price-tag display-6 text-info fw-bold">₹@Model.Price.ToString("N2")</span>
            </div>

            <p class="text-secondary fs-6 mb-4 leading-relaxed">
                @Model.Description
            </p>

            <div class="border-top border-secondary pt-3 mb-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-secondary">Availability:</span>
                    @if (Model.IsInStock)
                    {
                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                            <i class="fa-solid fa-circle-check me-1"></i> In Stock
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2">
                            <i class="fa-solid fa-circle-xmark me-1"></i> Out of Stock
                        </span>
                    }
                </div>
            </div>

            <div class="d-flex gap-3">
                <button class="btn btn-gradient px-4 py-2 text-white">
                    <i class="fa-solid fa-cart-shopping me-2"></i>Add to Cart
                </button>
            </div>
        </div>
    </div>
</div>