@model IEnumerable<ProductCatalogApp.Models.Product>

    @{
        ViewBag.Title = "Product Catalog";
    }

    <div class="row pt-5 pb-3 align-items-center">
        <div class="col-md-8">
            <h1 class="fw-extrabold display-6 text-white mb-1">Explore Products</h1>
            <p class="text-secondary">Discover premium tech gear and everyday essentials</p>
        </div>
    </div>

    <!-- Dark Filter Section -->
    <div class="card card-custom p-3 mb-5">
        <form method="get" action="@Url.Action("Index", "Catalog")" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text form-control-dark border-end-0"><i class="fa-solid fa-magnifying-glass text-secondary"></i></span>
                    <input type="text" name="searchQuery" value="@ViewBag.SearchQuery" class="form-control form-control-dark border-start-0" placeholder="Search product..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="category" class="form-select form-select-dark">
                    <option value="">All Categories</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in ViewBag.Categories)
                        {
                            if (cat == ViewBag.CurrentCategory)
                            {
                                <option value="@cat" selected>@cat</option>
                            }
                            else
                            {
                                <option value="@cat">@cat</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-gradient w-100 py-2">
                    <i class="fa-solid fa-sliders me-2"></i>Filter
                </button>
                <a href="@Url.Action("Index", "Catalog")" class="btn btn-outline-secondary border-secondary text-light px-3" title="Reset">
                    <i class="fa-solid fa-rotate-right"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Products Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card card-custom h-100 p-3 d-flex flex-column justify-content-between">
                        <div>
                            <!-- Product Image Rendering -->
                            <div class="rounded-3 overflow-hidden mb-3" style="height: 180px; background-color: #0f172a; border: 1px solid var(--border-color);">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" class="w-100 h-100" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                        <i class="fa-solid fa-image fa-3x text-secondary opacity-50"></i>
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge rounded-pill bg-purple-subtle text-warning border border-warning px-2 py-1" style="font-size: 0.7rem;">@item.Category</span>
                                @if (item.IsInStock)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1" style="font-size: 0.7rem;">In Stock</span>
                                }
                            </div>

                            <h5 class="fw-bold text-white mb-1 text-truncate" title="@item.Name">@item.Name</h5>
                            <p class="text-secondary small mb-3" style="height: 38px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                @item.Description
                            </p>
                        </div>

                        <div class="pt-3 border-top d-flex align-items-center justify-content-between" style="border-color: var(--border-color) !important;">
                            <!-- Indian Currency Display (₹) -->
                            <span class="price-tag">₹@item.Price.ToString("N2")</span>
                            @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-cyan px-3 py-1" })
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-ghost fa-4x text-secondary mb-3"></i>
                <h4 class="text-white">No items match your query</h4>
                <p class="text-secondary">Try searching for something else.</p>
            </div>
        }
    </div>
